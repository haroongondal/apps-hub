{
  "name": "strongroom-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Strongroom for Chrome (Manifest V3): fills and saves logins from a local encrypted vault",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --disable-warning=ExperimentalWarning --test src/__tests__/service.test.ts src/__tests__/common-passwords.test.ts src/__tests__/sync-store.test.ts src/__tests__/build.test.ts",
    "test:e2e": "node test/e2e.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "strongroom-core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "typescript": "~5.9.2"
  }
}
