{
  "expo": {
    "name": "HomeNet",
    "slug": "netlens",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "netlens",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "app.netlens",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "HomeNet scans your local Wi-Fi network to discover connected devices and services.",
        "NSBonjourServices": [
          "_services._dns-sd._udp",
          "_http._tcp",
          "_googlecast._tcp",
          "_airplay._tcp",
          "_ipp._tcp",
          "_smb._tcp",
          "_hap._tcp",
          "_companion-link._tcp"
        ]
      }
    },
    "android": {
      "package": "app.netlens",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "NEARBY_WIFI_DEVICES"
      ]
    },
    "plugins": [
      "expo-sqlite"
    ]
  }
}
