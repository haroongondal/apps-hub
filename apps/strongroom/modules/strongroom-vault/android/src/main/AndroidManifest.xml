<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />
  <!-- The autofill service reads each requesting app's signing certificate; without this, package visibility hides every app (checked on API 35). -->
  <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
  <!-- Autofill's keep-alive service needs these to run as a special-use foreground service behind an ongoing notification; without them the system can freeze the process and time out fill requests. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- §15.3: fill codes from text messages. The permission is requested from the Settings toggle only, never at setup;
       only the incoming-message broadcast is handled, never MMS and never the inbox. -->
  <uses-permission android:name="android.permission.RECEIVE_SMS" />
  <!-- §15.4: scan a site's QR. Requested by the scan screen at scan time only. A phone without a camera still installs. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <!-- A pass is presented to an NFC reader as an NDEF tag by host card emulation. Optional: phones without it just cannot present. -->
  <uses-permission android:name="android.permission.NFC" />
  <uses-feature android:name="android.hardware.nfc.hce" android:required="false" />
  <!-- App links (packages/app-link-contract): only apps signed with the same key hold this, and only they may read the expiry share. -->
  <permission android:name="com.haroon.permission.AUTOPILOT" android:protectionLevel="signature" />
  <uses-permission android:name="com.haroon.permission.AUTOPILOT" />
  <application>
    <!-- Card and pass expiry dates for sibling apps, when the owner turns it on in Settings. Read-only, no URI grants. -->
    <provider
      android:name="expo.modules.strongroomvault.android.ExpiryLinkProvider"
      android:authorities="com.haroon.strongroom.applink"
      android:exported="true"
      android:readPermission="com.haroon.permission.AUTOPILOT"
      android:writePermission="com.haroon.permission.AUTOPILOT" />
    <service
      android:name="expo.modules.strongroomvault.android.StrongroomAutofillService"
      android:label="Strongroom"
      android:exported="true"
      android:permission="android.permission.BIND_AUTOFILL_SERVICE">
      <intent-filter>
        <action android:name="android.service.autofill.AutofillService" />
      </intent-filter>
      <meta-data android:name="android.autofill" android:resource="@xml/strongroom_autofill_service" />
    </service>
    <!-- The background download (DESIGN §10): only the system's job scheduler may bind it. -->
    <service
      android:name="expo.modules.strongroomvault.android.SyncJobService"
      android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />
    <service
      android:name="expo.modules.strongroomvault.android.ClipboardClearJob"
      android:exported="false"
      android:permission="android.permission.BIND_JOB_SERVICE" />
    <!-- §15.3: the code extractor. A protected system broadcast, so only the platform can send it. -->
    <receiver
      android:name="expo.modules.strongroomvault.android.SmsReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.provider.Telephony.SMS_RECEIVED" />
      </intent-filter>
    </receiver>
    <activity
      android:name="expo.modules.strongroomvault.android.UnlockActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
      android:windowSoftInputMode="adjustResize"
      android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
    <activity
      android:name="expo.modules.strongroomvault.android.ScanActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
      android:theme="@style/Theme.AppCompat.DayNight.NoActionBar" />
    <service
      android:name="expo.modules.strongroomvault.android.StrongroomTagService"
      android:exported="true"
      android:permission="android.permission.BIND_NFC_SERVICE">
      <intent-filter>
        <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
      </intent-filter>
      <meta-data android:name="android.nfc.cardemulation.host_apdu_service" android:resource="@xml/strongroom_tag_service" />
    </service>
    <service
      android:name="expo.modules.strongroomvault.android.KeepAliveService"
      android:exported="false"
      android:foregroundServiceType="specialUse">
      <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="Autofill keep-alive: keeps the process out of the system freezer so Android delivers fill requests instead of timing them out." />
    </service>
  </application>
</manifest>
