<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-build override of src/main/res/xml/network_security_config.xml
     (build-type source sets shadow src/main during resource merging).
     Metro's dev server is plain HTTP at 10.0.2.2/localhost:8081, so debug
     builds must permit cleartext there or RN cannot even probe the packager
     ("CLEARTEXT communication to 10.0.2.2 not permitted"). Release keeps
     the strict scoped policy from src/main. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">www.vpngate.net</domain>
        <domain includeSubdomains="true">vpngate.net</domain>
    </domain-config>
</network-security-config>
