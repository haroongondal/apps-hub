    "test:e2e": "node test/e2e.mjs"
  },
  "main": "main.js",
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "electron": "44.8.0",
    "fabric": "7.4.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "playwright-core": "1.49.1"
  }
}
