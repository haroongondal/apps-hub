<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Same definition in every app that takes part in the links, so install order doesn't matter. -->
    <permission android:name="com.haroon.permission.AUTOPILOT" android:protectionLevel="signature" />
    <uses-permission android:name="com.haroon.permission.AUTOPILOT" />
    <application>
        <service
            android:name="expo.modules.haloengine.android.HaloService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Edge lighting" />
        </service>
        <service
            android:name="expo.modules.haloengine.android.HaloListener"
            android:exported="true"
            android:label="Halo"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <receiver
            android:name="expo.modules.haloengine.android.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <activity
            android:name="expo.modules.haloengine.android.AodActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:turnScreenOn="true" />
        <activity
            android:name="expo.modules.haloengine.android.AodPreviewActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- Only same-key apps may send the data-free "something changed" ping; Halo then re-reads the shares. -->
        <receiver
            android:name="expo.modules.haloengine.android.ChangedReceiver"
            android:exported="true"
            android:permission="com.haroon.permission.AUTOPILOT">
            <intent-filter>
                <action android:name="com.haroon.autopilot.CHANGED" />
            </intent-filter>
        </receiver>
        <!-- Halo's health row for the Store; read-only, same-key apps only. -->
        <provider
            android:name="expo.modules.haloengine.android.HaloLinkProvider"
            android:authorities="com.haroon.halo.applink"
            android:exported="true"
            android:readPermission="com.haroon.permission.AUTOPILOT"
            android:writePermission="com.haroon.permission.AUTOPILOT" />
    </application>
</manifest>
