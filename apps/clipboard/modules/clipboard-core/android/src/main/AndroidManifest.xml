<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="com.haroon.permission.AUTOPILOT" android:protectionLevel="signature" />
    <uses-permission android:name="com.haroon.permission.AUTOPILOT" />
    <application>
        <service
            android:name="expo.modules.clipboardcore.android.CaptureService"
            android:label="@string/clipboard_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/clipboard_accessibility_service" />
        </service>
        <!-- health for the Store; pinned for Nexus only, while the owner's switch is on -->
        <provider
            android:name="expo.modules.clipboardcore.android.ClipLinkProvider"
            android:authorities="com.haroon.clipboard.applink"
            android:exported="true"
            android:readPermission="com.haroon.permission.AUTOPILOT"
            android:writePermission="com.haroon.permission.AUTOPILOT" />
    </application>
</manifest>
