<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- find_contact, only once the owner allows it in Setup; set_alarm and set_timer; phone_info's network line. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Declared so "Select photos" leaves READ_MEDIA_IMAGES denied: a partial grant can't see new downloads. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Keeps an approval's heads-up on screen until it is answered (Notifier.gate). -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Same definition in every app that takes part in Autopilot, so install order doesn't matter. -->
    <permission android:name="com.haroon.permission.AUTOPILOT" android:protectionLevel="signature" />
    <uses-permission android:name="com.haroon.permission.AUTOPILOT" />
    <application>
        <service
            android:name="expo.modules.deputyagent.android.DeputyAccessibilityService"
            android:label="@string/deputy_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/deputy_accessibility_service" />
        </service>
        <service
            android:name="expo.modules.deputyagent.android.RunService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Phone agent task" />
        </service>
        <!-- Inflow's Run tap. Only apps holding the signature permission can start it; it shows nothing. -->
        <activity
            android:name="expo.modules.deputyagent.android.RunSuggestionActivity"
            android:exported="true"
            android:permission="com.haroon.permission.AUTOPILOT"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Share sheet target for text and links. It opens Deputy's screen with the text as a draft; nothing starts without the owner's tap. -->
        <activity
            android:name="expo.modules.deputyagent.android.ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <receiver
            android:name="expo.modules.deputyagent.android.GateReceiver"
            android:exported="false" />
    </application>
    <!-- open_app lists launchable apps without QUERY_ALL_PACKAGES (SPEC §14). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <provider android:authorities="com.haroon.inflow.autopilot" />
    </queries>
</manifest>
