# Copy to .env and fill in. Loaded automatically in dev and bundled into
# packaged builds via electron-builder's extraResources; never committed.
AI_GATEWAY_API_KEY=

# Dev-only per-step run trace, written to userData/runs/<runId>/.
# 1 writes trace.jsonl; dom also dumps each step's filtered DOM. Leave unset otherwise.
#AUTOMATION_DEBUG=1

# Which input path drives click and type: cdp for trusted events through
# chrome.debugger, synthetic for the in-page fallback. Unset means cdp, falling
# back to synthetic whenever the debugger is unavailable.
#AUTOMATION_INPUT=cdp

# Which backend drives the browser: playwright launches a dedicated Chrome on
# its own profile; extension drives your everyday Chrome through the MV3
# extension and native host. Unset means playwright.
#AUTOMATION_BACKEND=playwright

# Explicit Chrome binary for the playwright backend, when it is not in a
# standard install location.
#AUTOMATION_CHROME_PATH=
