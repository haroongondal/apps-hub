{
  "name": "autonomous-browsing",
  "version": "0.1.0",
  "private": true,
  "description": "Electron workspace for chat-authored automation routines with dynamic system-routine updates",
  "main": "out/main/index.js",
  "author": "Outsentia",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "node scripts/db-verify.mjs",
    "eval": "node scripts/run-evals.mjs",
    "test:extension": "node tests/content-script.verify.mjs",
    "test:playwright": "node scripts/run-playwright-verify.mjs",
    "install:host": "node scripts/install-native-host.mjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder",
    "dist:local": "electron-vite build && electron-builder --config.mac.identity=- --config.mac.notarize=false --config.mac.forceCodeSigning=false --config.win.forceCodeSigning=false",
    "dist:mac": "electron-vite build && electron-builder --mac --universal",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "dist:mac:local": "electron-vite build && electron-builder --mac --universal --config.mac.identity=- --config.mac.notarize=false --config.mac.forceCodeSigning=false",
    "dist:win:local": "electron-vite build && electron-builder --win --x64 --config.win.forceCodeSigning=false"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "playwright-core": "^1.62.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.1.0",
    "@types/react-dom": "~19.1.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
