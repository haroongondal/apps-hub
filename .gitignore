# node / pnpm
node_modules/
*.log
.npm/

# expo / react-native builds (root-anchored: DO NOT match apps/*/modules/*/android|ios)
/apps/netlens/android/.gradle/
/apps/netlens/android/app/build/
/apps/netlens/android/build/
/apps/netlens/android/local.properties
/apps/netlens/android/**/.cxx/
/apps/netlens/modules/*/android/build/
/apps/netlens/ios/build/
/apps/netlens/.expo/
/apps/open_tunnel_vpn/android/.gradle/
/apps/open_tunnel_vpn/android/app/build/
/apps/open_tunnel_vpn/android/build/
/apps/open_tunnel_vpn/android/local.properties
/apps/open_tunnel_vpn/android/**/.cxx/
/apps/open_tunnel_vpn/modules/*/android/build/
/apps/open_tunnel_vpn/ios/build/
/apps/open_tunnel_vpn/ios/Pods/
/apps/open_tunnel_vpn/.expo/
/apps/open_tunnel_vpn/**/*.xcuserstate
/apps/open_tunnel_vpn/project.xcworkspace/xcuserdata/

# electron (future apps)
/apps/*/dist/
/apps/*/out/

# misc
.DS_Store
coverage/
*.tsbuildinfo

# signing material & secrets (apps-hub store pipeline) — never commit
*.jks
*.p12
*.p8
*.mobileprovision
*.keystore
!/apps/*/android/app/debug.keystore
.env
.env.*
!.env.example
.dev.vars
/apps/store/android/.gradle/
/apps/store/android/app/build/
/apps/store/android/build/
/apps/store/android/local.properties
/apps/store/android/**/.cxx/
/apps/store/modules/*/android/build/
/apps/store/.expo/
/apps/deputy/android/.gradle/
/apps/deputy/android/app/build/
/apps/deputy/android/build/
/apps/deputy/android/local.properties
/apps/deputy/android/**/.cxx/
/apps/deputy/modules/*/android/build/
/apps/deputy/.expo/
/tools/store-api/.cloudflare/
/tools/store-api/.wrangler/
/tools/store-api/dist/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
/apps/pdf-editor-mobile/android/.gradle/
/apps/pdf-editor-mobile/android/app/build/
/apps/pdf-editor-mobile/android/build/
/apps/pdf-editor-mobile/android/local.properties
/apps/pdf-editor-mobile/android/**/.cxx/
/apps/pdf-editor-mobile/ios/build/
/apps/pdf-editor-mobile/ios/Pods/
/apps/pdf-editor-mobile/.expo/
/apps/pdf-editor-mobile/assets/editor/editor.html
/apps/pdf-editor-desktop/test/*.pdf
/apps/design-editor/test/out/

# release APKs are build outputs; the store pipeline uploads its own builds
/apps/*/releases/*.apk
