{
  "name": "@apps-hub/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared design system: tokens (pure TS), React Native components, and web/tokens.css for the Electron apps",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts",
    "./web/*": "./web/*",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "build:css": "node scripts/build-css.ts",
    "test": "node --test src/__tests__/tokens.test.ts src/__tests__/web-css.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "expo-font": "*",
    "react": "*",
    "react-native": "*",
    "react-native-safe-area-context": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  }
}
